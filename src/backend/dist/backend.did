type WordId = nat;
type Word = 
 record {
   audio: text;
   aymara: text;
   category: text;
   difficulty: nat;
   example: text;
   id: WordId;
   image: opt text;
   mastery: nat;
   spanish: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UnitId = nat;
type Unit = 
 record {
   description: text;
   id: UnitId;
   lessons: vec Lesson;
   locked: bool;
   title: text;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PhraseId = nat;
type Phrase = 
 record {
   audio: text;
   aymara: text;
   category: text;
   difficulty: nat;
   explanation: text;
   id: PhraseId;
   spanish: text;
 };
type LessonId = nat;
type Lesson = 
 record {
   difficulty: nat;
   examples: vec text;
   exercises: vec Exercise;
   id: LessonId;
   mastery: nat;
   objective: text;
   title: text;
   vocabulary: vec WordId;
   xp: nat;
 };
type ExerciseType = 
 variant {
   fillBlank;
   matchWordMeaning;
   multipleChoice;
   orderWords;
   selectAymaraWord;
   selectTranslation;
   trueFalse;
 };
type ExerciseId = nat;
type Exercise = 
 record {
   correctAnswer: text;
   exerciseType: ExerciseType;
   explanation: text;
   id: ExerciseId;
   options: vec text;
   prompt: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  getCallerUserRole: () -> (UserRole) query;
  getLesson: (unitId: UnitId, lessonId: LessonId) -> (opt Lesson) query;
  getPhrase: (id: PhraseId) -> (opt Phrase) query;
  getPhrases: () -> (vec Phrase) query;
  getUnit: (id: UnitId) -> (opt Unit) query;
  getUnits: () -> (vec Unit) query;
  getWord: (id: WordId) -> (opt Word) query;
  getWords: () -> (vec Word) query;
  isCallerAdmin: () -> (bool) query;
  schema: () -> (text) query;
}
